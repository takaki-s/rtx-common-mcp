  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "cheerio": "1.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.2.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  }
